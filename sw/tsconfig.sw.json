{
  // The Service Worker is not part of `tsc -b` (tsconfig.json lists its projects and is owned by the
  // skeleton batch); check it by hand with `npx tsc -p sw/tsconfig.sw.json`. Vite builds it as the client entry `sw`.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "WebWorker"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "types": []
  },
  "include": ["sw.ts"]
}
